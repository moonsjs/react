{
  "name": "@moonsjs/react",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moonsjs/react.git"
  },
  "homepage": "https://github.com/moonsjs/docs",
  "bugs": {
    "url": "https://github.com/moonsjs/react/issues"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "bun": "./src/client.ts",
      "default": "./dist/client.js"
    },
    "./internal": {
      "types": "./src/internal.tsx",
      "bun": "./src/internal.tsx",
      "default": "./dist/internal.js"
    },
    "./ssr": {
      "types": "./src/ssr.ts",
      "bun": "./src/ssr.ts",
      "default": "./dist/ssr.js"
    }
  },
  "scripts": {
    "prepack": "bun run build",
    "build": "rm -rf dist && tsc -p tsconfig.json --emitDeclarationOnly && bun build src/index.ts src/client.ts src/internal.tsx src/ssr.ts --outdir dist --target node --format esm --splitting --sourcemap=external --external react --external 'react/*' --external react-dom --external 'react-dom/*' --external @moonsjs/core --external '@moonsjs/core/*' --external 'virtual:*'",
    "test": "bun test"
  },
  "dependencies": {
    "@moonsjs/core": "^0.2.0"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "@types/bun": "^1.4.3"
  }
}
